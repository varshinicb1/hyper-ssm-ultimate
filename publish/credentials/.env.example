# ─── ICM Tool Factory — Credentials ───
# Copy this file to .env and fill in your keys.
# NEVER commit .env or credentials/*.json to git.

# Chrome Web Store
# Get these from https://console.cloud.google.com (Chrome Web Store API)
CHROME_CLIENT_ID=your-client-id.apps.googleusercontent.com
CHROME_CLIENT_SECRET=your-client-secret
CHROME_REFRESH_TOKEN=your-refresh-token
CHROME_ITEM_ID=your-extension-id-from-web-store

# Gumroad
# Get token from https://gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=your-gumroad-access-token

# GitHub (for publishing)
# Already configured if you can push to the repo
GITHUB_TOKEN=your-github-token

# Razorpay (for generating payment links programmatically)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
